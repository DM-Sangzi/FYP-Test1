# --- Mock vs Real backend switch ---
# Set to "true" during the UI development phase (uses MSW + localStorage).
# Set to "false" when the backend cryptographic services are ready,
# and point VITE_API_BASE_URL at the real server. No component code changes
# are required to switch over (see PRD §5.3).
VITE_USE_MOCK=true

# Base URL for the real backend API. Only used when VITE_USE_MOCK=false.
VITE_API_BASE_URL=http://localhost:8080
